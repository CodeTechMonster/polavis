PORT=8787
ANTHROPIC_API_KEY=sk-ant-your-key-here
ML_SERVICE_URL=http://localhost:8000

# Which Claude model the AI recommendation features call. Leave unset to use the default
# (claude-opus-5, defined in backend/ai/model-config.ts). Set this to fall back to a faster or
# cheaper model without editing code, e.g. ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL=

# Set to "true" to test the Claude recommendation button end-to-end (button click -> JSON ->
# UI) without a real ANTHROPIC_API_KEY. Returns a mock response built from the real risk/SHAP
# data for that trip. Leave unset or "false" to use the real Claude API.
MOCK_CLAUDE=false

# Analyze Route Conditions feature (traffic + weather risk adjustment on top of the base
# XGBoost score). Ontario 511 (traffic) needs no API key at all -- confirmed directly against
# https://511on.ca/help/endpoint/event, whose URI Parameters table lists only optional
# format/lang, no key. Get a free OpenWeather key at https://openweathermap.org/api for the
# weather half; without it, weather falls back to mock automatically (traffic still stays real).
# Set MOCK_ROUTE_CONDITIONS=true to force both into mock mode for a clean, repeatable demo.
OPENWEATHERMAP_API_KEY=your-openweathermap-key-here
MOCK_ROUTE_CONDITIONS=false

# --- SPUR AI (optional alternative provider) ---
# Only used when "Use SPUR AI instead of Anthropic" is switched on in Settings; that toggle is off
# by default. Without a key here the toggle returns a clear error rather than silently falling back
# to Anthropic, so a switched-on toggle that appears to do nothing can't go unnoticed.
SPUR_API_KEY=sk-spur-your-key-here
# Both optional; shown for reference. Defaults are used when unset.
# SPUR_BASE_URL=https://ai.spuric.com/v1
# SPUR_MODEL=spur-chat
